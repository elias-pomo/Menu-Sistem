# Base de datos
# Local con `npm run db:dev` (prisma dev): ver las URLs con `npx prisma dev ls`.
# Neon: DATABASE_URL = conexión con pooler (host con -pooler), la usa la app.
DATABASE_URL=""
# Neon: conexión directa (sin -pooler), solo para migraciones y seed. La escribe `neon env pull`.
DATABASE_URL_UNPOOLED=""
# Local con PGlite: una base aparte para la shadow database de las migraciones.
SHADOW_DATABASE_URL=""
# Tope de conexiones por instancia. Producción: 3 a 5. Local con prisma dev: 1.
DATABASE_POOL_MAX="1"

# Contraseña de los usuarios de prueba que crea el seed (mínimo 10 caracteres). Solo para desarrollo.
SEED_PASSWORD=""

# Usuario dueño que crea `npm run db:piloto` (opcional).
PILOTO_OWNER_EMAIL=""
PILOTO_OWNER_PASSWORD=""

# Vercel Blob (fotos de productos), store con acceso público. En Vercel lo carga solo al conectar el store
# (BLOB_STORE_ID, con autenticación OIDC). En local: BLOB_STORE_ID + VERCEL_OIDC_TOKEN (vercel env pull)
# o un BLOB_READ_WRITE_TOKEN del store. Sin ninguno, la subida de fotos responde 503.
BLOB_STORE_ID="store_4FDMiCuFPhPcbTi9"
BLOB_READ_WRITE_TOKEN=""
