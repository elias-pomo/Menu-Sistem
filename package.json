{
  "name": "menu-pedidos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:dev": "prisma dev --name menu-local --detach",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:piloto": "tsx --conditions=react-server prisma/piloto.ts",
    "db:prod:migrate": "node --env-file=.env.produccion scripts/prod-guard.mjs && node --env-file=.env.produccion node_modules/prisma/build/index.js migrate deploy",
    "db:prod:status": "node --env-file=.env.produccion scripts/prod-guard.mjs && node --env-file=.env.produccion node_modules/prisma/build/index.js migrate status",
    "db:prod:piloto": "node --env-file=.env.produccion scripts/prod-guard.mjs && node --env-file=.env.produccion node_modules/tsx/dist/cli.mjs --conditions=react-server prisma/piloto.ts",
    "prod:smoke": "node --env-file=.env.produccion scripts/prod-guard.mjs && node --env-file=.env.produccion node_modules/tsx/dist/cli.mjs --conditions=react-server scripts/prod-smoke.ts",
    "start:prod": "node --env-file=.env.produccion node_modules/next/dist/bin/next start",
    "db:preview:migrate": "node --env-file=.env.preview scripts/prod-guard.mjs && node --env-file=.env.preview node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.3",
    "date-fns": "^4.4.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
